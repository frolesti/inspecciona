# Copy this file to .env.vm and adjust values before deploying to VM.

CORRECTOR_HOST=corrector.example.org
SINONIMS_HOST=sinonims.example.org
LETSENCRYPT_EMAIL=admin@example.org

# Timezone for service logs and JVM
TZ=Europe/Madrid

# JVM max heap for LanguageTool in MB
LT_HEAP_MB=1536
LT_XMS_MB=512

# Number of LanguageTool parallel check threads
LT_MAX_CHECK_THREADS=16

# JVM heap for sinonims service in MB
SINONIMS_HEAP_MB=512
SINONIMS_XMS_MB=256

# Set true only when you need to force a clean rebuild at container startup
FORCE_REBUILD=false
