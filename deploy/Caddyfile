{$CORRECTOR_HOST} {
  encode zstd gzip
  tls {$LETSENCRYPT_EMAIL}
  log {
    output file /var/log/caddy/corrector-access.log {
      roll_size 20MiB
      roll_keep 14
      roll_keep_for 336h
    }
    format json
  }
  @sinonims path /sinonims-api/*
  reverse_proxy @sinonims sinonims:8000 {
    transport http {
      dial_timeout 5s
      response_header_timeout 30s
      read_timeout 60s
      write_timeout 60s
      keepalive 2m
    }
  }
  reverse_proxy languagetool:8081 {
    transport http {
      dial_timeout 5s
      response_header_timeout 30s
      read_timeout 60s
      write_timeout 60s
      keepalive 2m
    }
  }
}

{$SINONIMS_HOST} {
  encode zstd gzip
  tls {$LETSENCRYPT_EMAIL}
  log {
    output file /var/log/caddy/sinonims-access.log {
      roll_size 20MiB
      roll_keep 14
      roll_keep_for 336h
    }
    format json
  }
  reverse_proxy sinonims:8000
}
