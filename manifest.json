{
    "manifest_version":  3,
    "name":  "Inspecciona",
    "version":  "1.3.0",
    "description":  "Corrector ortogràfic, gramatical i tipogràfic per al català amb serveis locals (Docker).",
    "permissions":  [
                        "storage",
                        "activeTab",
                        "scripting",
                        "permissions"
                    ],
    "host_permissions":  [
                             "http://localhost/*",
                             "http://127.0.0.1/*",
                             "http://[::1]/*",
                             "https://corrector.34.118.197.141.nip.io/*"
                         ],
    "optional_host_permissions":  [
                                      "https://*/*",
                                      "http://*/*"
                                  ],
    "background":  {
                       "service_worker":  "src/background.js",
                       "type":  "module"
                   },
    "action":  {
                   "default_title":  "Inspecciona",
                   "default_popup":  "src/popup/popup.html",
                   "default_icon":  {
                                        "16":  "assets/icon-16.png",
                                        "32":  "assets/icon-32.png",
                                        "48":  "assets/icon-48.png"
                                    }
               },
    "icons":  {
                  "16":  "assets/icon-16.png",
                  "32":  "assets/icon-32.png",
                  "48":  "assets/icon-48.png",
                  "128":  "assets/icon-128.png"
              },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "\u003call_urls\u003e"
                                            ],
                                "js":  [
                                           "src/content/helpers.js",
                                           "src/content/content.js"
                                       ],
                                "css":  [
                                            "src/content/content.css"
                                        ],
                                "all_frames":  true,
                                "run_at":  "document_idle"
                            }
                        ]
}
