{
    "manifest_version":  3,
    "name":  "Inspecciona",
    "version":  "1.0.0",
    "description":  "Assistent en català: correcció, sinònims i suggeriments amb serveis de Softcatalà.",
    "permissions":  [
                        "storage",
                        "activeTab",
                        "scripting"
                    ],
    "host_permissions":  [
                             "https://api.softcatala.org/*"
                         ],
    "background":  {
                       "service_worker":  "src/background.js",
                       "type":  "module"
                   },
    "action":  {
                   "default_title":  "Inspecciona",
                   "default_popup":  "src/popup/popup.html",
                   "default_icon":  {
                                        "16":  "assets/icon-16.png",
                                        "32":  "assets/icon-32.png",
                                        "48":  "assets/icon-48.png"
                                    }
               },
    "icons":  {
                  "16":  "assets/icon-16.png",
                  "32":  "assets/icon-32.png",
                  "48":  "assets/icon-48.png",
                  "128":  "assets/icon-128.png"
              },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "\u003call_urls\u003e"
                                            ],
                                "js":  [
                                           "src/content/helpers.js",
                                           "src/content/content.js"
                                       ],
                                "css":  [
                                            "src/content/content.css"
                                        ],
                                "run_at":  "document_idle"
                            }
                        ]
}
