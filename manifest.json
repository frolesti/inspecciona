{
  "manifest_version": 3,
  "name": "Inspecciona",
  "version": "0.1.0",
  "description": "Assistent en català: correcció, sinònims i suggeriments amb serveis de Softcatalà.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://api.softcatala.org/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Inspecciona",
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ]
}